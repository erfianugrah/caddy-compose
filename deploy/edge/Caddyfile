jellyfin.erfi.io {
	import waf_off
	import tls_config_rfc2136
	encode zstd gzip
	# Cache image endpoints only (posters/backdrops/thumbs - the hot path
	# for remote clients). Media streams (.ts HLS segments are per-session
	# transcode artifacts, not shareable), /socket and the API stay uncached.
	# Query string stays in the cache key (api_key lives there -> per-client
	# entries, no cross-user leakage).
	reverse_proxy 10.0.71.35:8096 {
		import proxy_headers
		flush_interval -1
		transport http {
			dial_timeout 10s
			response_header_timeout 0
		}
	}
	import error_pages
	import site_log jellyfin
}

