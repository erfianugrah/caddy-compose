# composer (edge instance) - canonical composer going forward; servarr's
# instance keeps composer.servarr.erfi.io until retirement. Native site
# (container publishes *:8080 on this host). No `import waf`: mirrors the
# servarr-side posture - the API needs curl + github webhook access, which
# the policy engine's UA rules would block; composer's own API-key/session
# auth is the gate.
composer.erfi.io {
	import tls_config_rfc2136
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		import proxy_headers
		# SSE streams (container logs, stats, events) and WebSocket (terminal)
		# require unbuffered proxying for real-time data.
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 0
		}
	}
	import error_pages
	import site_log composer
}

# atuin sync server - moved from servarr (2026-07-22). Same proxy-to-edge
# model as vault.erfi.io until cutover.
#
# `import waf_off` (2026-08-29): the policy_engine body scan costs ~23us/byte
# (~43KB/s) and atuin record-sync POSTs are hundreds of KB per batch, so every
# batch cost 3-5s while the upstream answered in ~1ms - a 36k-record upload
# projected to ~35h. Measured on the same caddy over loopback with one 200KB
# body: atuin vhost (import waf) 4680ms, httpbin vhost (no waf) 11ms, straight
# to the upstream 1ms; cost scaled linearly 5KB->400KB. Body inspection buys
# nothing here regardless - atuin sync payloads are client-side-encrypted
# opaque ciphertext, so CRS body regexes have nothing to match, and the
# endpoint is authenticated by bearer session token.
atuin.erfi.io {
	import waf_off
	import tls_config_rfc2136
	encode zstd gzip
	reverse_proxy 10.0.71.64:8888 {
		import proxy_headers
	}
	import error_pages
	import site_log atuin
}

