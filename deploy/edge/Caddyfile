# Open WebUI chat front-end. Manages its own auth (Authelia SSO gate removed
# 2026-07-23). Dual-bound on servarr. The Remote-Email/Remote-Name strip is
# load-bearing: OWUI has WEBUI_AUTH_TRUSTED_*_HEADER set, so a client-supplied
# header would be trusted SSO - never let them through from outside.
chat.erfi.io {
	import waf_off
	import tls_config_rfc2136
	encode zstd gzip
	reverse_proxy 10.0.71.2:18081 {
		import proxy_headers
		header_up -Remote-Email
		header_up -Remote-Name
	}
	import error_pages
	import site_log chat
}

# central monitoring (composer stack `monitoring` on servarr, renamed from
# sbperf-monitoring 2026-08-09): Prometheus, 30d retention, scrapes the
# Supabase project metrics endpoints AND the router's vector edge-metrics
# exporter. It has no auth of its own, so it is private-ranges only. Proxies
# a LAN IP, not a bridge IP: the container sits on the servarr_lan macvlan
# (10.0.71.59) like every other externally-proxied servarr service, and this
# Caddy has no route into servarr's docker bridges.
prometheus.erfi.io {
	import waf_off
	import tls_config_rfc2136
	import lan_only
	encode zstd gzip
	reverse_proxy 10.0.71.59:9090 {
		import proxy_headers
	}
	import error_pages
	import site_log prometheus
}

# central monitoring: Grafana over that Prometheus. Manages its own auth
# (admin login, password in the monitoring composer stack env), so no edge
# gate - same treatment as chat.erfi.io.
grafana.erfi.io {
	import waf_off
	import tls_config_rfc2136
	encode zstd gzip
	reverse_proxy 10.0.71.60:3000 {
		import proxy_headers
	}
	import error_pages
	import site_log grafana
}

# wafctl -> Caddy admin API proxy, restricted to the edge-waf bridge subnet.
:2020 {
	log {
		output stderr
		level WARN
	}
	@allowed remote_ip 172.31.98.0/24
	handle @allowed {
		reverse_proxy localhost:2019 {
			header_up Host localhost:2019
		}
	}
	handle {
		respond "Forbidden" 403
	}
}
