memledger.erfi.io {
	import waf_off
	import tls_config_rfc2136
	import memledger_auth
	encode zstd gzip

	# root serves the UI (exact match only) - without this / falls through to
	# PostgREST and returns the raw OpenAPI JSON. Assets keep resolving via the
	# /ui* handle_path below; every API path (/rpc/*, /sessions, ...) still proxies.
	# Served by the stack's caddy file-server on servarr lan (.68). The favicon
	# rides along: the browser probes /favicon.ico before it parses the HTML whose
	# linked icon is /ui/favicon.ico, and without this it 404s at PostgREST.
	@root path /
	@favicon path /favicon.ico
	handle @root {
		reverse_proxy 10.0.71.68:8080 {
			import proxy_headers
		}
	}
	handle @favicon {
		reverse_proxy 10.0.71.68:8080 {
			import proxy_headers
		}
	}

	# search UI - static single page, API calls go same-origin to PostgREST
	handle_path /ui* {
		reverse_proxy 10.0.71.68:8080 {
			import proxy_headers
		}
	}

	# MCP endpoint (read-only tools) - bearer required from EVERY network:
	# MCP clients send Authorization; nothing else should reach this surface
	handle /mcp* {
		@mcp_noauth not header Authorization "Bearer {$MEMLEDGER_TOKEN}"
		respond @mcp_noauth 401
		reverse_proxy 10.0.71.67:8000 {
			header_up -Authorization
			import proxy_headers
		}
	}

	# semantic (pgvector) search - the stack's embedder service
	handle_path /semantic* {
		reverse_proxy 10.0.71.67:8000 {
			header_up -Authorization
			import proxy_headers
		}
	}

	# servarr stack: postgrest on servarr lan (.70)
	reverse_proxy 10.0.71.70:3000 {
		# PostgREST would mistake the gate bearer for a JWT - strip it
		header_up -Authorization
		import proxy_headers
	}
	import error_pages
	import site_log memledger
}

